from collections import deque

graph = {
    1: [2, 7],
    2: [3, 6],
    3: [4, 5],
    4: [],
    5: [9],
    6: [8],
    7: [8, 10],
    8: [9],
    9: [],
    10: []
}

visited = set()
queue = deque([1])

while queue:
    node = queue.popleft()

    if node not in visited:
        print(node, end=" ")
        visited.add(node)
        queue.extend(n for n in graph[node] if n not in visited)
